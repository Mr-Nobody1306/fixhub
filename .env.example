# NEVER commit this file with a real key in it. It is git-ignored on purpose.
# Copy to a file named exactly ".env" and fill it in. The server reads it
# at startup. The browser can NEVER fetch this file (only public/ is served).
PORT=8000
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Set on the API host to your GitHub Pages origin; leave blank for same-origin development.
FRONTEND_ORIGIN=
# Your Groq secret key (console.groq.com -> API Keys).
# Configure this only in the backend host's environment settings.
GROQ_API_KEY=PASTE_YOUR_KEY_HERE
